<Window x:Class="ScreenshotProgramm.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screenshot Editor" Height="780" Width="1100"
        MinHeight="640" MinWidth="900"
        KeyDown="OnWindowKeyDown">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button x:Name="TextToolButton" Content="Text" Click="SelectTextTool"/>
            <Button x:Name="RectangleToolButton" Content="Rechteck" Click="SelectRectangleTool"/>
            <Button x:Name="EllipseToolButton" Content="Ellipse" Click="SelectEllipseTool"/>
            <Button x:Name="ArrowToolButton" Content="Pfeil" Click="SelectArrowTool"/>
            <Button x:Name="BlurToolButton" Content="Blur" Click="SelectBlurTool"/>
            <Separator/>
            <ComboBox x:Name="ColorPicker" Width="120" SelectedIndex="0">
                <ComboBoxItem Content="Red" />
                <ComboBoxItem Content="Blue" />
                <ComboBoxItem Content="Green" />
                <ComboBoxItem Content="Yellow" />
                <ComboBoxItem Content="White" />
            </ComboBox>
            <Separator/>
            <Button x:Name="SaveButton" Content="Speichern" Click="SaveClicked"/>
            <Button x:Name="CancelButton" Content="Abbrechen" Click="CancelClicked"/>
        </ToolBar>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Image x:Name="ScreenshotImage" Stretch="None" />
                <Canvas x:Name="DrawingCanvas" Background="Transparent" MouseLeftButtonDown="OnCanvasMouseDown" MouseMove="OnCanvasMouseMove" MouseLeftButtonUp="OnCanvasMouseUp"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
